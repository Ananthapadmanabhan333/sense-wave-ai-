# ─── SenseWave backend ────────────────────────────────────────────────
# Postgres. In docker-compose this resolves to the `postgres` service.
SENSEWAVE_DATABASE_URL=postgresql+asyncpg://sensewave:sensewave@postgres:5432/sensewave

# JWT signing secret for SenseWave's OWN auth (Phase 2). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENSEWAVE_JWT_SECRET=change-me-in-production
SENSEWAVE_JWT_TTL_MINUTES=720

# Seeded admin (Phase 2 login). Password is hashed at first startup.
SENSEWAVE_ADMIN_EMAIL=admin@sensewave.local
SENSEWAVE_ADMIN_PASSWORD=change-me

# ─── Upstream RuView sensing-server ───────────────────────────────────
# WebSocket stream consumed by the single ingest worker.
SENSEWAVE_UPSTREAM_WS_URL=ws://sensing-server:8765/ws/sensing
# REST base, used for calibration/recording proxying (Phase 4).
SENSEWAVE_UPSTREAM_HTTP_URL=http://sensing-server:8080

# Bearer token for the upstream. RuView's own clients read RUVIEW_API_TOKEN;
# we accept either name so a shared .env works for both.
RUVIEW_API_TOKEN=
SENSEWAVE_UPSTREAM_TOKEN=

# ─── Ingest tuning ────────────────────────────────────────────────────
# Upstream ticks at 10 Hz; we persist at most this many readings/sec/room.
SENSEWAVE_INGEST_HZ=1.0
# A node with no frame for this long renders STALE. See product rule 3.
SENSEWAVE_STALE_AFTER_SECONDS=10.0
# Reconnect backoff (seconds): initial, cap. Jitter is applied on top.
SENSEWAVE_RECONNECT_BACKOFF_INITIAL=0.5
SENSEWAVE_RECONNECT_BACKOFF_MAX=30.0

# Below this, vitals render as "low confidence" and never as a number.
# See product rule 1. This is a display/alerting floor, not a filter:
# the raw value is still persisted with its confidence.
SENSEWAVE_MIN_VITALS_CONFIDENCE=0.5

# ─── Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SENSEWAVE_API_URL=http://localhost:8000
NEXT_PUBLIC_SENSEWAVE_WS_URL=ws://localhost:8000/api/ws/live

# Zero-hardware demo helpers. Seed a demo site/room on boot, and let newly
# discovered nodes land in that room so the simulate source produces visible
# data. Leave SENSEWAVE_AUTO_MAP_ROOM_ID empty in a real deployment: SenseWave
# does not guess which room a sensor is in.
SENSEWAVE_SEED_DEMO=true
SENSEWAVE_AUTO_MAP_ROOM_ID=1

LOG_LEVEL=INFO
